CONFIG_IDF_CMAKE=y
CONFIG_IDF_TARGET_ARCH_XTENSA=y
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_IDF_FIRMWARE_CHIP_ID=0x0009
CONFIG_SDK_TOOLPREFIX="xtensa-esp32s3-elf-"


CONFIG_BOOTLOADER_OFFSET_IN_FLASH=0x0000
CONFIG_PARTITION_TABLE_OFFSET=0x9000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="part.lst"
CONFIG_PARTITION_TABLE_FILENAME="part.lst"

CONFIG_TONIEBOX_ESP32_V1_6_C=y
CONFIG_AUDIO_BOARD_CUSTOM=y


CONFIG_ESPTOOLPY_BAUD_921600B=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_BAUD=921600
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"


CONFIG_BOOTLOADER_APP_TEST=y
CONFIG_BOOTLOADER_NUM_PIN_APP_TEST=20
CONFIG_BOOTLOADER_HOLD_TIME_GPIO=5

# do not store PHY calibration in the NVS that belongs to the original firmware
# CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE is not set

# phones send long headers when probing for a captive portal
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# the original bootloader supports rollback: new firmware boots on probation
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Memory: no PSRAM on the box, everything shares ~270 KB internal RAM.
# Heap debugging was on (poisoning, tracing, task tracking: RAM and CPU on
# every allocation) and turned any failed allocation into a crash.
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_HEAP_TRACING_OFF=y
# CONFIG_HEAP_TASK_TRACKING is not set
# CONFIG_HEAP_ABORT_WHEN_ALLOCATION_FAILS is not set
# restart after a panic instead of halting (looked like a hang)
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# WiFi: fewer buffers (bounds the peaks under traffic) and its code in flash;
# the box needs ~100 kbit/s
# CONFIG_ESP32_WIFI_IRAM_OPT is not set
# CONFIG_ESP32_WIFI_RX_IRAM_OPT is not set
CONFIG_ESP32_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=16
# TLS: teddyCloud sends records of up to 16 KB unless asked for less; with
# 8192 every content download failed after the HTTP header. Buffers are
# allocated per record (dynamic) and records are limited to 4 KB via
# max_fragment_length (main/tls_mfl.c), which needs OUT_CONTENT_LEN >= 4096.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# carried over from the IDF 4.4 sdkconfig (set there beyond the defaults)
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_FATFS_API_ENCODING_ANSI_OEM=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=16
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=64
CONFIG_FATFS_PER_FILE_CACHE=n
CONFIG_FREERTOS_HZ=200
CONFIG_FREERTOS_ISR_STACKSIZE=2096
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_HAL_DEFAULT_ASSERTION_LEVEL=0
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# IDF 5: no PSRAM on the box, keep IRAM small so the heap stays large
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# security: TLS 1.2 only (teddyCloud does not need 1.3, which costs RAM)
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n

# ESP-ADF headers still use the old FreeRTOS type names
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# faster WiFi after waking up: keep the last DHCP address and the PHY (radio)
# calibration in NVS instead of a full DHCP exchange / calibration every time
CONFIG_LWIP_DHCP_RESTORE_LAST_IP=y
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=y

# release build: our code, lwIP, mbedTLS and the WiFi glue are compiled from
# source (-Og before; the WiFi and Opus libraries are prebuilt anyway)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# downloads: TCP window and WiFi RX buffers as with IDF 4.4 (5.7 KB window,
# ~170 KiB/s). A 23 KB window with 32 dynamic RX buffers was tried in
# f9d700e: on the box the free heap fell to 8 KB during a download.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6

# a stuck system (idle task starved for 5 s) restarts instead of draining the battery
CONFIG_ESP_TASK_WDT_PANIC=y

# 240 MHz: at 160 MHz some (teddyCloud encoded) tonies played slowed and
# stuttering on IDF 5 while WiFi/TLS were busy; fine at 240 MHz (box test)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# only to set the CPU clock from teddybox.ini (cpu_mhz), fixed, no light sleep
CONFIG_PM_ENABLE=y
